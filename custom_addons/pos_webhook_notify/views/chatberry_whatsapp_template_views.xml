<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <menuitem id="menu_chatberry_root"
            name="Chatberry"
            sequence="80"
            groups="base.group_system"/>

  <record id="view_chatberry_whatsapp_template_list" model="ir.ui.view">
    <field name="name">chatberry.whatsapp.template.list</field>
    <field name="model">chatberry.whatsapp.template</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="whatsapp_template_name"/>
        <field name="language_code"/>
        <field name="header_media_type"/>
        <field name="header_media_source"/>
        <field name="company_id"/>
        <field name="active" widget="boolean_toggle"/>
      </list>
    </field>
  </record>

  <record id="view_chatberry_whatsapp_template_form" model="ir.ui.view">
    <field name="name">chatberry.whatsapp.template.form</field>
    <field name="model">chatberry.whatsapp.template</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name"/></h1>
          </div>
          <group>
            <group>
              <field name="whatsapp_template_name"/>
              <field name="language_code"/>
              <field name="company_id"/>
            </group>
            <group>
              <field name="active" widget="boolean_toggle"/>
              <field name="header_media_type"/>
              <field name="header_media_source"/>
            </group>
          </group>
          <notebook>
            <page string="Header Media">
              <group>
                <field name="header_media_url"/>
                <field name="header_attachment_id"/>
                <field name="header_field_id" options="{'no_create': True, 'no_open': True}"/>
                <field name="header_field_path"/>
              </group>
            </page>
            <page string="Variables">
              <field name="variable_ids">
                <list editable="bottom">
                  <field name="position"/>
                  <field name="name"/>
                  <field name="component_type"/>
                  <field name="button_id"/>
                  <field name="value_type"/>
                  <field name="crm_lead_field_id" options="{'no_create': True, 'no_open': True}"/>
                  <field name="field_path" optional="hide"/>
                  <field name="static_value"/>
                  <field name="fallback_value"/>
                  <field name="required"/>
                </list>
              </field>
            </page>
            <page string="Buttons">
              <field name="button_ids">
                <list editable="bottom">
                  <field name="button_index"/>
                  <field name="name"/>
                  <field name="button_type"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_chatberry_whatsapp_template_search" model="ir.ui.view">
    <field name="name">chatberry.whatsapp.template.search</field>
    <field name="model">chatberry.whatsapp.template</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="whatsapp_template_name"/>
        <field name="language_code"/>
        <filter name="active" string="Active" domain="[('active', '=', True)]"/>
        <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
      </search>
    </field>
  </record>

  <record id="action_chatberry_whatsapp_template" model="ir.actions.act_window">
    <field name="name">WhatsApp Templates</field>
    <field name="res_model">chatberry.whatsapp.template</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_chatberry_whatsapp_template_search"/>
  </record>

  <menuitem id="menu_chatberry_whatsapp_template"
            name="WhatsApp Templates"
            parent="menu_chatberry_root"
            action="action_chatberry_whatsapp_template"
            sequence="10"
            groups="base.group_system"/>
</odoo>
